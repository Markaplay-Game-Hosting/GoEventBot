        "Event.Create.Request": {
            "description": "Information required to update a new event",
            "type": "object",
            "properties": {
                "channel_id": {
                    "description": "Discord ID of the channel the bot will post the event",
                    "type": "string"
                },
                "description": {
                    "description": "Description/Content of the event",
                    "type": "string"
                },
                "duration": {
                    "description": "Duration of the each event following ISO 8601 standard",
                    "type": "string",
                    "example": "PT30M"
                },
                "guild_id": {
                    "description": "Discord Guild ID/server the bot will publish on",
                    "type": "string"
                },
                "is_active": {
                    "description": "If the event is active of not",
                    "type": "boolean"
                },
                "rrule": {
                    "description": "Recurrence rule following RFC 5545 https://icalendar.org/rrule-tool.html",
                    "type": "string",
                    "example": "FREQ=WEEKLY;INTERVAL=1;BYDAY=MO;UNTIL=20250731T000000Z"
                },
                "title": {
                    "description": "Title of the  event",
                    "type": "string"
                }
            }
        },
        "Event.Get": {
            "description": "Event Response object",
            "type": "object",
            "properties": {
