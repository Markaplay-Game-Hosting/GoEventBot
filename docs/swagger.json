                },
                "created_date": {
                    "description": "Creation date of the event",
                    "type": "string"
                },
                "description": {
                    "description": "Description/Content of the event",
                    "type": "string"
                },
                "duration": {
                    "description": "Duration of the event following the ISO 8601 standard",
                    "type": "string",
                    "example": "PT30M"
                },
                "guild_id": {
                    "description": "Discord Guild ID/server the bot will publish on",
                    "type": "string"
                },
                "id": {
                    "description": "ID of the event",
                    "type": "string"
                },
                "is_active": {
                    "description": "Tell if the event is currently active",
